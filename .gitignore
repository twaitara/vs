# Secrets — never commit real DB credentials
config.php

# Real customer data dump — keep out of version control
valuation.sql

# Uploaded files (photos, logbooks)
uploads/*
!uploads/.htaccess
!uploads/index.html

# Runtime logs/storage (keep the folder + guards, not the logs)
storage/*
!storage/.htaccess
!storage/index.html

# OS / editor cruft
.DS_Store
Thumbs.db
*.log
