# Copy this file to `.env` and fill in real values.
# Then use the config.sample.php loader (copy it to config.php).
# .env is gitignored — secrets never reach the repo.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpaneluser_valuation
DB_USER=cpaneluser_admin
DB_PASS=CHANGE_ME

APP_NAME=Kennet Valuation
BASE_URL=/vs
CURRENCY=KES
TZ=Africa/Nairobi

# Set to true only while debugging (shows errors on screen)
APP_DEBUG=false
