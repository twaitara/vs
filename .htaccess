# ============================================================
# Kennet Valuation — standalone app in the /vs subfolder.
# Serves index.php for /vs/, and routes opaque page codes
# (…/vs/<code>) to the front controller r.php.
# ============================================================

# Open index.php when someone visits /vs/
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /vs/

    # Serve real files and directories directly (assets, .php, .js, images, sw.js…)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Anything else that looks like a page code -> the front controller
    RewriteRule ^([a-f0-9]{6,16})/?$ r.php?c=$1 [L,QSA]
</IfModule>

# Make sure this folder is publicly accessible.
<IfModule mod_authz_core.c>
    Require all granted
</IfModule>

# Don't let anyone open the raw database dump / docs in a browser.
<FilesMatch "\.(sql|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
