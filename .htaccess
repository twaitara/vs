# Kennet Valuation — run as a standalone app inside this folder.
# Stop the parent (WordPress) .htaccess rewrite rules from hijacking requests.
RewriteEngine Off

# Serve index.php when the folder is opened.
DirectoryIndex index.php

# Block direct web access to sensitive files in this folder.
<FilesMatch "\.(sql|md)$">
  Require all denied
</FilesMatch>
